# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/

# Tailwind v4 bounds its content scan with this file. Without it, the scanner
# walks node_modules — 32,000+ files, read synchronously — and a cold build
# appears to hang forever.

# Env
.env
.env*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
.vercel
next-env.d.ts
tsconfig.tsbuildinfo
.claude/
